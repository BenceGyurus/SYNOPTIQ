# Copy to .env. Generate each secret with: openssl rand -hex 32
POSTGRES_USER=solaris
POSTGRES_PASSWORD=replace-with-a-random-password
POSTGRES_DB=solaris
INTERNAL_API_SECRET=replace-with-a-separate-random-secret
BETTER_AUTH_SECRET=replace-with-a-third-random-secret
BETTER_AUTH_URL=http://localhost:3000
PORT=3000

# Optional: preconfigure one inverter. Otherwise use the admin UI.
INVERTER_NAME=Home inverter
INVERTER_SERIAL=
INVERTER_IP=
INVERTER_PORT=8484
INVERTER_TIMEZONE=Europe/Budapest
POLLING_INTERVAL_SECONDS=30

# Optional: OIDC from environment takes precedence over admin UI settings.
OIDC_NAME=
OIDC_DISCOVERY_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
